{
  "name": "@slga/studio",
  "private": true,
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "schema:extract": "sanity schema extract --path schema.json --enforce-required-fields",
    "typegen": "pnpm schema:extract && sanity typegen generate",
    "content:dry-run": "sanity exec scripts/import-original-content.ts -- --dry-run",
    "content:import-original": "sanity exec scripts/import-original-content.ts --with-user-token -- --confirm-production"
  },
  "dependencies": {
    "@sanity/vision": "^4.0.0",
    "sanity": "^4.0.0",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.0",
    "typescript": "^5.7.0"
  }
}
